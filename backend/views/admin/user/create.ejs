<%- include("../../partials/header", {
    pageTitle: "Create user",
    navLink: { href: "/users", label: "User list" }
}) %>

<main class="container page-shell">
    <div class="row g-4 align-items-start">
        <div class="col-lg-3">
            <%- include("../../partials/sidebar", { activePage: "users" }) %>
        </div>

        <div class="col-lg-9 col-xl-8">
            <header class="page-heading">
                <p class="eyebrow">Users / New</p>
                <h1 class="page-title">Add a user</h1>
                <p class="page-subtitle">Enter the account details below. All fields are required.</p>
            </header>

            <section class="content-card">
                <div class="content-card-body">
                    <%- include("../../partials/alert", {
                        message: typeof error !== "undefined" ? error : null
                    }) %>

                    <form action="/api/v1/users" method="post">
                        <%- include("../../partials/user-form-fields", {
                            usernameValue: typeof username !== "undefined" ? username : "",
                            dateOfBirthValue: typeof dateOfBirth !== "undefined" ? dateOfBirth : "",
                            passwordLabel: "Password",
                            passwordPlaceholder: "Create a password",
                            confirmPasswordLabel: "Confirm password"
                        }) %>

                        <p class="form-hint mb-4">Make sure both password fields contain the same value.</p>

                        <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2">
                            <a class="btn btn-outline-secondary" href="/users">Cancel</a>
                            <button class="btn btn-primary" type="submit">Create user</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</main>

<%- include("../../partials/footer") %>
