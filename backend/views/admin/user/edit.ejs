<%- include("../../partials/header", {
    pageTitle: "Edit user",
    navLink: { href: "/users", label: "User list" }
}) %>

<main class="container page-shell">
    <div class="row g-4 align-items-start">
        <div class="col-lg-3">
            <%- include("../../partials/sidebar", { activePage: "users" }) %>
        </div>

        <div class="col-lg-9 col-xl-8">
            <header class="page-heading">
                <p class="eyebrow">Users / #<%= user.userId %></p>
                <h1 class="page-title">Edit <%= user.username %></h1>
                <p class="page-subtitle">Make the changes you need, then save the record.</p>
            </header>

            <section class="content-card">
                <div class="content-card-body">
                    <div id="error-message" class="alert alert-danger d-none" role="alert" aria-live="polite"></div>

                    <form id="edit-user-form" data-id="<%= user.userId %>">
                        <%- include("../../partials/user-form-fields", {
                            usernameValue: user.username,
                            dateOfBirthValue: user.dateOfBirth || "",
                            passwordLabel: "New password",
                            passwordPlaceholder: "Enter a new password",
                            confirmPasswordLabel: "Confirm new password"
                        }) %>

                        <p class="form-hint mb-4">Saving will replace the user's current password.</p>

                        <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2">
                            <a href="/users" class="btn btn-outline-secondary">Cancel</a>
                            <button id="submit-button" class="btn btn-primary" type="submit">Save changes</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</main>

<script src="/js/edit-user.js" defer></script>
<%- include("../../partials/footer") %>
