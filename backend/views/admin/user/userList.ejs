<%- include("../../partials/header", {
    pageTitle: "Users",
    navLink: { href: "/", label: "Home" }
}) %>

<main class="container page-shell">
    <div class="row g-4 align-items-start">
        <div class="col-lg-3">
            <%- include("../../partials/sidebar", { activePage: "users" }) %>
        </div>

        <div class="col-lg-9">
            <header class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
                <div>
                    <p class="eyebrow">Directory</p>
                    <h1 class="page-title">Users</h1>
                    <p class="page-subtitle">Find an account or keep its details up to date.</p>
                </div>
                <a class="btn btn-primary" href="/users/create">Add user</a>
            </header>

            <section class="search-card mb-4">
                <form class="row g-2 align-items-center" method="get" action="/users">
                    <div class="col-md">
                        <label for="keyword" class="visually-hidden">Search by username</label>
                        <input type="search" class="form-control" id="keyword" name="keyword"
                            placeholder="Search username" value="<%= keyword || '' %>">
                    </div>
                    <div class="col-6 col-md-auto">
                        <button class="btn btn-primary w-100" type="submit">Search</button>
                    </div>
                    <div class="col-6 col-md-auto">
                        <a class="btn btn-outline-secondary w-100" href="/users">Reset</a>
                    </div>
                </form>
            </section>

            <section class="content-card table-card">
                <% if (users.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>User</th>
                                    <th>Date of birth</th>
                                    <th>Created</th>
                                    <th>Updated</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach((user) => { %>
                                    <tr>
                                        <td><span class="id-badge">#<%= user.userId %></span></td>
                                        <td>
                                            <div class="user-cell">
                                                <span class="user-avatar"><%= user.username.charAt(0).toUpperCase() %></span>
                                                <span><%= user.username %></span>
                                            </div>
                                        </td>
                                        <td><%= user.dateOfBirth || "—" %></td>
                                        <td class="text-nowrap"><%= new Date(user.createdAt).toLocaleDateString("en-GB") %></td>
                                        <td class="text-nowrap"><%= new Date(user.updatedAt).toLocaleDateString("en-GB") %></td>
                                        <td>
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="/users/edit/<%= user.userId %>"
                                                    class="btn btn-soft-warning btn-sm">Edit</a>
                                                <button type="button" class="btn btn-soft-danger btn-sm delete-user"
                                                    data-id="<%= user.userId %>" data-username="<%= user.username %>">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <strong>No users found</strong>
                        <span>Try another search or create a new user.</span>
                    </div>
                <% } %>
            </section>
        </div>
    </div>
</main>

<script src="/js/user-list.js" defer></script>
<%- include("../../partials/footer") %>
