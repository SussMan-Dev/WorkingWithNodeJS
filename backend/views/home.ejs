<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Home | UserHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/index.css">
</head>

<body class="app-body">
    <nav class="app-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand" href="/">
                <span class="brand-mark">U</span>
                <span>UserHub</span>
            </a>
            <div class="nav-actions">
                <a class="nav-link-simple" href="/users">View users</a>
                <a class="btn btn-sm btn-outline-primary" href="/auth/login">Sign in</a>
            </div>
        </div>
    </nav>

    <main class="hero">
        <div class="container hero-layout">
            <section>
                <p class="eyebrow">User directory</p>
                <h1 class="hero-title">Keep your user records tidy.</h1>
                <p class="hero-copy">
                    Add accounts, update details, and find the person you need without digging through complicated menus.
                </p>
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a class="btn btn-primary px-4" href="/users">Browse users</a>
                    <a class="btn btn-outline-primary px-4" href="/users/create">Add a user</a>
                </div>
                <p class="hero-note">A small workspace for everyday account management.</p>
            </section>

            <aside class="home-panel" aria-label="Quick actions">
                <div class="home-panel-header">
                    <span>Quick actions</span>
                    <span class="status-label">Ready</span>
                </div>
                <a class="home-action" href="/users">
                    <span class="home-action-number">01</span>
                    <span>
                        <strong>Open the directory</strong>
                        <small>View and search all accounts</small>
                    </span>
                    <span class="home-action-arrow" aria-hidden="true">→</span>
                </a>
                <a class="home-action" href="/users/create">
                    <span class="home-action-number">02</span>
                    <span>
                        <strong>Add a new user</strong>
                        <small>Create an account record</small>
                    </span>
                    <span class="home-action-arrow" aria-hidden="true">→</span>
                </a>
                <a class="home-action" href="/auth/login">
                    <span class="home-action-number">03</span>
                    <span>
                        <strong>Sign in</strong>
                        <small>Continue with an existing account</small>
                    </span>
                    <span class="home-action-arrow" aria-hidden="true">→</span>
                </a>
                <div class="home-panel-footer">Simple tools, all in one place.</div>
            </aside>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>
