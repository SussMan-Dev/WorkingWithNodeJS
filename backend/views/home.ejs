            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a class="btn btn-primary px-4" href="/auth/register">Create account</a>
                <a class="btn btn-outline-primary px-4" href="/auth/login">Sign in</a>
            </div>
        </section>
