<%- include("../partials/header", { pageTitle: "Create account", showNavbar: false }) %>

<main class="auth-page">
    <div class="auth-wrap">
        <div class="auth-brand">
            <%- include("../partials/brand") %>
        </div>

        <section class="auth-card">
            <h1 class="auth-title">Create an account</h1>
            <p class="auth-subtitle">Add a few details to set up your profile.</p>

            <%- include("../partials/alert", {
                message: typeof error !== "undefined" ? error : null
            }) %>

            <form action="/auth/register" method="post">
                <%- include("../partials/user-form-fields", {
                    usernameValue: typeof username !== "undefined" ? username : "",
                    dateOfBirthValue: typeof dateOfBirth !== "undefined" ? dateOfBirth : "",
                    passwordLabel: "Password",
                    passwordPlaceholder: "Create a password",
                    confirmPasswordLabel: "Confirm password"
                }) %>

                <button class="btn btn-primary w-100 mt-4" type="submit">Create account</button>
            </form>

            <p class="auth-footer">
                Already have an account? <a href="/auth/login">Log in</a>
            </p>
        </section>
    </div>
</main>

<%- include("../partials/footer") %>
