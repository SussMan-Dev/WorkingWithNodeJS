<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= pageTitle %> | UserHub
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/index.css">
</head>

<body class="app-body">
    <% if (typeof showNavbar==="undefined" || showNavbar) { %>
        <nav class="app-navbar">
            <div class="container d-flex align-items-center justify-content-between">
                <%- include("brand") %>

                    <% if (typeof navbarVariant !=="undefined" && navbarVariant==="auth" ) { %>
                        <div class="nav-actions">
                            <a class="btn btn-sm btn-outline-primary" href="/auth/login">Sign in</a>
                            <a class="btn btn-sm btn-primary" href="/auth/register">Create account</a>
                        </div>
                        <% } else if (typeof navLink !=="undefined" && navLink) { %>
                            <a class="btn btn-sm btn-outline-primary" href="<%= navLink.href %>">
                                <%= navLink.label %>
                            </a>
                            <% } %>
            </div>
        </nav>
        <% } %>