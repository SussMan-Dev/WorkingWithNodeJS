<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Home | UserHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/index.css">
</head>

<body class="app-body">
    <nav class="app-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand" href="/">
                <span class="brand-mark">U</span>
                <span>UserHub</span>
            </a>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-primary" href="/auth/login">Log in</a>
                <a class="btn btn-sm btn-primary" href="/auth/register">Create account</a>
            </div>
        </div>
    </nav>

    <main class="hero">
        <div class="container text-center">
            <p class="eyebrow">Simple user management</p>
            <h1 class="hero-title">Manage your users with <span>less effort.</span></h1>
            <p class="hero-copy">
                A clean and lightweight place to create accounts, find users, and keep profile information up to date.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a class="btn btn-primary px-4" href="/users">Open user list</a>
                <a class="btn btn-outline-primary px-4" href="/auth/register">Get started</a>
            </div>

            <div class="feature-strip text-start">
                <div class="feature-item">
                    <strong>Easy to use</strong>
                    <span>A focused interface without unnecessary steps.</span>
                </div>
                <div class="feature-item">
                    <strong>Quick search</strong>
                    <span>Find the account you need in seconds.</span>
                </div>
                <div class="feature-item">
                    <strong>Simple editing</strong>
                    <span>Keep user details accurate and current.</span>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>
