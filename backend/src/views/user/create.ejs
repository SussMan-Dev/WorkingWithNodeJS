<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create user | UserHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/index.css">
</head>

<body class="app-body">
    <nav class="app-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand" href="/">
                <span class="brand-mark">U</span>
                <span>UserHub</span>
            </a>
            <a class="btn btn-sm btn-outline-primary" href="/users">User list</a>
        </div>
    </nav>

    <main class="container page-shell">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <header class="page-heading">
                    <p class="eyebrow">User management</p>
                    <h1 class="page-title">Create a new user</h1>
                    <p class="page-subtitle">Add the account details below. All fields are required.</p>
                </header>

                <section class="content-card">
                    <div class="content-card-body">
                        <% if (typeof error !== "undefined" && error) { %>
                            <div class="alert alert-danger" role="alert">
                                <%= error %>
                            </div>
                        <% } %>

                        <form action="/api/v1/users" method="post" id="userForm">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label for="username" class="form-label">Username</label>
                                    <input id="username" name="username" type="text" class="form-control"
                                        placeholder="Enter a username"
                                        value="<%= typeof username !== 'undefined' ? username : '' %>"
                                        autocomplete="username" required autofocus>
                                </div>

                                <div class="col-md-5">
                                    <label for="dateOfBirth" class="form-label">Date of birth</label>
                                    <input id="dateOfBirth" name="dateOfBirth" type="date" class="form-control"
                                        value="<%= typeof dateOfBirth !== 'undefined' ? dateOfBirth : '' %>" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="password" class="form-label">Password</label>
                                    <input id="password" name="password" type="password" class="form-control"
                                        placeholder="Create a password" autocomplete="new-password" required>
                                </div>

                                <div class="col-md-6">
                                    <label for="confirmPassword" class="form-label">Confirm password</label>
                                    <input id="confirmPassword" name="confirmPassword" type="password"
                                        class="form-control" placeholder="Enter the password again"
                                        autocomplete="new-password" required>
                                </div>
                            </div>

                            <p class="form-hint mb-4">Make sure both password fields contain the same value.</p>

                            <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2">
                                <a class="btn btn-outline-secondary" href="/users">Cancel</a>
                                <button class="btn btn-primary" type="submit">Create user</button>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>
