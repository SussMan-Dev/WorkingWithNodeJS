<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <h1 style="justify-self:center">User List</h1>
    <a class="btn btn-primary m-3" href="/users/create">Create new User</a>
    <div class="m-3">
        <form class="d-flex gap-2 m-3 align-items-center" method="get" action="/users">
            <label for="keyword" class="form-label mb-0">Enter Username:</label>
            <input type="text" class="form-control w-25" id="username" name="keyword"
                placeholder="Enter username you're finding">
            <button type="submit" class="btn btn-primary">
                Submit
            </button>
        </form>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">UserName</th>
                <th scope="col">Password</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(function(user) { %>
                <tr>
                    <td>
                        <%= user.username %>
                    </td>
                    <td>
                        <%= user.password %>
                    </td>
                    <td class="d-flex p-2 gap-2">
                        <a href="/users/edit/<%= user.userId %>" class="btn btn-primary">Edit</a>
                        <form action="/users/<%= user.userId %>" method="post">
                            <button class="btn btn-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }); %>

        </tbody>
    </table>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>