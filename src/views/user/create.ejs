<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <h1 style="justify-content:center; display: flex; ">Creating new User</h1>
    <div class="container-sm">

        <% if (typeof error !=="undefined" && error) { %>
            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>
            <% } %>

                <form action="/api/v1/users" method="post" id="userForm">
                    <!-- username input -->
                    <div class="mb-3">
                        <label for="username" class="form-label">UserName:</label>
                        <input id="username" name="username" type="text" class="form-control"
                            placeholder="Enter Username" value="<%= typeof username !== 'undefined' ? username : '' %>">
                    </div>
                    <!-- birthday input -->
                    <div class="mb-3">
                        <label for="dateOfBirth" class="form-label">BirthDay:</label>
                        <input id="dateOfBirth" name="dateOfBirth" type="date" class="form-control"
                            value="<%= typeof dateOfBirth !== 'undefined' ? dateOfBirth : '' %>">
                    </div>
                    <!-- password input -->
                    <div class="mb-3">
                        <label for="password" class="form-label">Password:</label>
                        <input id="password" name="password" type="password" class="form-control"
                            placeholder="Enter Password">
                    </div>
                    <!-- validate password input -->
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">
                            Confirm password
                        </label>
                        <input id="confirmPassword" name="confirmPassword" type="password" class="form-control"
                            placeholder="Enter password to confirm">
                    </div>
                    <!-- submit button -->
                    <button class="btn btn-primary" type="submit">
                        Submit
                    </button>

                </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>